rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'jbn1jbn0101@gmail.com';
    }

    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','text','createdAt'])
        && request.resource.data.name is string && request.resource.data.text is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300;
      allow update, delete: if false;
    }

    match /songs/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name','category','title','youtubeId','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.category in ['bhajan','padayatra','aarti']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.youtubeId is string && request.resource.data.youtubeId.size() == 11
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /media/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name','type','title','url','caption','category','storagePath','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.type in ['photo','video']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.url is string && request.resource.data.url.size() > 0 && request.resource.data.url.size() <= 500
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 300
        && request.resource.data.category in ['general','padyatra','mandir','bhandara']
        && request.resource.data.status == 'pending'
        && request.resource.data.storagePath is string;
      allow update, delete: if isAdmin();
    }

    match /seva/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name','type','location','time','phone','note','mediaUrl','mediaType','storagePath','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.type is string && request.resource.data.type.size() > 0 && request.resource.data.type.size() <= 100
        && request.resource.data.location is string && request.resource.data.location.size() > 0 && request.resource.data.location.size() <= 150
        && request.resource.data.time is string && request.resource.data.time.size() > 0 && request.resource.data.time.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 15
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType in ['', 'photo', 'video']
        && request.resource.data.storagePath is string
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /mediaLikes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['mediaId','createdAt'])
        && request.resource.data.mediaId is string
        && request.resource.data.mediaId.size() > 0;
      allow update, delete: if false;
    }

    match /mediaComments/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['mediaId','name','text','createdAt','status'])
        && request.resource.data.mediaId is string
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.status == 'approved';
      allow update, delete: if isAdmin();
    }

    match /posters/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}